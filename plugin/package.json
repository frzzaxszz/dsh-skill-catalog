{
  "name": "dsh-skill-catalog",
  "description": "DSH Web GUI skill catalog (personal fork of dsh-skill-picker): a button beside the composer opens a searchable list of every installed skill with Chinese annotations; picking one inserts the official `/skill-name` gesture into the input box, so the skill loads with your message. Also covers skill disable/enable, reveal, uninstall-with-backup, pinning and shared cross-device state. Not published to npm: this fork is never overwritten by an upstream upgrade.",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "fuzzysort": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.1": "unknown",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "unknown",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || >=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || >=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || >=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || >=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.6 || >=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || >=0.2.0-rc.1 <1.0.0-0",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frzzaxszz/dsh-skill-catalog.git"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.3"
  }
}
